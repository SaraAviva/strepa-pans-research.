// Reuse installed 6.0.1 configuration with bounded local execution in SLURM.
executor {
    name = 'local'
    cpus = 6
    memory = '24 GB'
    queueSize = 6
}
process {
    executor = 'local'
    cpus = 1
    errorStrategy = 'terminate'
    maxRetries = 0
    withLabel: dynamic { cpus = 1 }
    withName: 'DOWNLOAD_INTERPRO|DOWNLOAD_DATABASE' {
        beforeScript = 'echo "Database downloads are forbidden for this run" >&2; exit 74'
        errorStrategy = 'terminate'
        maxRetries = 0
    }
    withName: 'SEARCH_ANTIFAM|SEARCH_NCBIFAM|SEARCH_PFAM|SEARCH_PIRSR|SEARCH_PIRSF|SEARCH_SUPERFAMILY' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-hmmer-3.3.img' }
    withName: 'SEARCH_GENE3D|SEARCH_FUNFAM' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-cath-0.16.10.img' }
    withName: 'SEARCH_CDD' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-cdd-1.0.img' }
    withName: 'RUN_COILS' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-ncoils-2.2.1.img' }
    withName: 'RUN_PFSEARCH|RUN_PSSCAN' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-pftools-3.2.12.img' }
    withName: 'RUN_MOBIDBLITE' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-idrpred-1.0.3.img' }
    withName: 'SEARCH_PANTHER|RUN_TREEGRAFTER' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-panther-1.0.img' }
    withName: 'RUN_PRINTS' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-fingerprintscan-3.597.ebiftp.img' }
    withName: 'SEARCH_SFLD' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-sfld-ebiftp.img' }
    withName: 'PREFILTER_SMART|SEARCH_SMART' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-smart-1.0.img' }
    withName: 'ADD_XREFS|REPRESENTATIVE_LOCATIONS' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-groovy-4.0.27-1.img' }
    withName: 'DOWNLOAD_INTERPRO|DOWNLOAD_DATABASE' { container = '/hb/groups/cornejo_training/StrepA_project_revamped/tools/interproscan6/singularity_cache/interpro-download-1.0.img' }
}
singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/hb/groups/cornejo_training/StrepA_project_revamped/interproscan_all_significant_20261003T043208Z_b2a74f5f/runtime/singularity_cache'
    runOptions = '-B /mnt/beegfs -B /hb'
}
trace {
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,cpus,memory,peak_rss,container,workdir'
    raw = true
}
